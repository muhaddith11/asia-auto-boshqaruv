# ─── Supabase ────────────────────────────────────────────────────────────────
# Loyiha URL va kalitlar (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server tomon (faqat backend route'larda ishlatiladi, brauzerga chiqmaydi)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Telegram bot ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
ADMIN_TELEGRAM_ID=123456789
# Buyurtma "tayyor" (tulanmagan) bo'lganda xabar yuboriladigan guruh
# Chat ID (masalan: -1001234567890) yoki @username
TELEGRAM_GROUP_ID=-1001234567890
# Ixtiyoriy: guruh ichidagi mavzu (topic) ID — faqat "Topics" yoqilgan guruhlar uchun
TELEGRAM_GROUP_THREAD_ID=1737
# Bot pollerini avtomatik ishga tushirish (1 = ha)
START_POLLER=0

# ─── SMS (Eskiz.uz) ──────────────────────────────────────────────────────────
ESKIZ_EMAIL=you@example.com
ESKIZ_PASSWORD=your-eskiz-password

# ─── Avtorizatsiya ───────────────────────────────────────────────────────────
# Sessiya tokenini imzolash uchun maxfiy kalit (uzun, tasodifiy qator qo'ying!)
AUTH_SECRET=uzun-tasodifiy-maxfiy-kalit-bu-yerga
# Akkaunt parollari (berilmasa kod ichidagi default ishlatiladi)
OWNER_PASSWORD=
PARTNER_PASSWORD=
WORKER_PASSWORD=

# ─── Ilova ───────────────────────────────────────────────────────────────────
# API bazaviy yo'l (odatda /api)
NEXT_PUBLIC_API_BASE=/api
# Saytning to'liq manzili (bot/webhook uchun)
NEXT_PUBLIC_SITE_URL=https://example.com

# ─── Ball/bonus tizimi ────────────────────────────────────────────────────────
# Vercel Cron so'rovlarini tekshirish uchun (vercel.json'dagi crons shu bilan himoyalanadi)
CRON_SECRET=uzun-tasodifiy-maxfiy-kalit-bu-yerga
# 1 ball necha so'm — birinchi oy natijasidan keyin sozlang
POINTS_SOM_PER_BALL=5000
# Bonus/jarima xodimning shu oy ishlab topganining necha foizidan oshmasin (xavfsizlik chegarasi)
POINTS_MAX_PERCENT_OF_EARNED=20

# ─── Tezlik normasi ───────────────────────────────────────────────────────────
# Normadan shu FOIZ ga oshsa hali jarima yo'q (20 daq ishga 6 daq, 3 kunlik ishga ~21 soat)
POINTS_GRACE_PERCENT=30
# Normaning shu ulushidan tez bajarilsa katta bonus (+3), aks holda oddiy bonus (+2)
POINTS_FAST_BONUS_RATIO=0.6
# Ustaxona ish soatlari (Toshkent vaqti) — vaqt faqat shu oraliqda sanaladi,
# kechasi qolib ketgan mashina uchun xodim jarima olmaydi
WORK_DAY_START_HOUR=9
WORK_DAY_END_HOUR=21
